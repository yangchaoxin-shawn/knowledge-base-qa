# 大模型 API 配置
# 硅基流动 API（推荐，国内访问更稳定）
# 网站地址：https://www.siliconflow.cn/ （注册获取 API Key）
# API 地址：https://api.siliconflow.cn/v1 （代码调用）
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# 模型配置（硅基流动支持的模型）
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=Qwen/Qwen3-8B
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# FAISS 向量数据库配置（使用 CPU 版本）
FAISS_PERSIST_DIRECTORY=./data/faiss_index

# 日志配置
LOGS_DIRECTORY=./logs

# 检索配置
DEFAULT_K=5

# 应用配置
DEBUG=true
LOG_LEVEL=INFO